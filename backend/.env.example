# Copy this to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://illusions_user:illusions_pass@localhost:5432/illusions

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Production-only (ignored while DEBUG=True) ---
# Flip to True only after confirming HTTPS actually works end-to-end in
# front of this app — see the comment in settings.py for why.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=2592000
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
DJANGO_LOG_LEVEL=INFO

# Optional error monitoring — leave blank to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
ENVIRONMENT=development
